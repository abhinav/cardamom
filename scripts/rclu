#!/usr/bin/env bash
#
# rclu — run `clu` against a remote machine's project over SSH.
#
# clu is local-first (one SQLite file per machine, no network). When you run
# more than one clu-aware box — e.g. a coordinator machine plus agent boxes —
# you sometimes want to fire a command at another box's tracker: ping its
# coordinator, seed a batch, read its `ready`. This wraps the SSH dance so you
# don't hand-quote a `cd && /full/path/clu …` string every time.
#
# It is intentionally a thin helper, not a clu feature: it sets CLU_DIR
# (no `cd`), uses the remote's full clu path (a non-interactive SSH shell
# won't have ~/go/bin on PATH), shell-quotes the args, and forwards stdin so
# message bodies ride the pipe instead of being quoted into the command.
#
# USAGE
#   rclu <remote> <clu args...>            run a clu command on <remote>
#   rclu ls                                list configured remotes
#   echo "msg" | rclu <remote> ping coordinator -      body via stdin (no quoting)
#   rclu coach ready -a developer
#   node gen.js | rclu coach batch --on-existing update
#
# REMOTES
#   Defined in $RCLU_CONFIG (default ~/.config/rclu/remotes), one per line:
#       <name>  <ssh-target>  <CLU_DIR>  [clu-binary]
#   First run writes a commented example there.
#
# ENV
#   RCLU_CONFIG   path to the remotes file
#   RCLU_SSH      ssh command to use (default "ssh"; e.g. "ssh -t" for a TTY)

set -euo pipefail

CONFIG="${RCLU_CONFIG:-$HOME/.config/rclu/remotes}"
SSH="${RCLU_SSH:-ssh}"

die() { printf 'rclu: %s\n' "$*" >&2; exit 1; }

bootstrap() {
  mkdir -p "$(dirname "$CONFIG")"
  cat > "$CONFIG" <<'EOF'
# rclu remotes — one per line:  <name> <ssh-target> <CLU_DIR> [clu-binary]
# (whitespace-separated; lines starting with # are ignored)
#
# coach  royvk@100.106.22.7  /Users/royvk/workspace/coach-platform/.clu  /Users/royvk/go/bin/clu
EOF
  printf 'rclu: wrote an example config to %s — edit it, then re-run.\n' "$CONFIG" >&2
}

usage() {
  cat <<EOF
usage:
  rclu <remote> <clu args...>          run a clu command on <remote>
  rclu ls                              list configured remotes
  echo "msg" | rclu <remote> ping coordinator -   (body via stdin, no quoting)

config: $CONFIG
EOF
}

# lookup <name> → sets TARGET, DIR, BIN; returns 1 if not found.
lookup() {
  local want="$1" name target dir bin
  while read -r name target dir bin || [ -n "$name" ]; do
    case "$name" in ''|\#*) continue ;; esac
    if [ "$name" = "$want" ]; then
      TARGET="$target"; DIR="$dir"; BIN="${bin:-clu}"
      [ -n "$TARGET" ] && [ -n "$DIR" ] || die "remote '$want' is missing a target or CLU_DIR in $CONFIG"
      return 0
    fi
  done < "$CONFIG"
  return 1
}

[ -f "$CONFIG" ] || { bootstrap; exit 1; }

case "${1:-}" in
  ''|-h|--help) usage; exit 0 ;;
  ls)
    grep -vE '^[[:space:]]*(#|$)' "$CONFIG" | awk '{printf "%-12s %s\n", $1, $2}'
    exit 0 ;;
esac

remote="$1"; shift
[ "$#" -gt 0 ] || die "no clu command given (e.g. rclu $remote ready)"
lookup "$remote" || die "unknown remote '$remote' — see 'rclu ls' ($CONFIG)"

# Shell-quote each arg so URLs / spaces / semicolons survive the remote
# shell's re-parse. The message body itself should come via stdin ('-'),
# which $SSH forwards by default — so it never has to be quoted at all.
# `env VAR=val cmd` (rather than a `VAR=val cmd` prefix) works regardless of
# the remote login shell.
printf -v args '%q ' "$@"
exec $SSH "$TARGET" "env CLU_DIR=$(printf '%q' "$DIR") $(printf '%q' "$BIN") $args"
